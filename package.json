{
  "name": "@ouim/agentkit",
  "version": "0.2.0",
  "type": "module",
  "description": "One layer over your locally signed-in Claude Code, Codex and OpenCode. Build agent harnesses (paseo / t3code style) without provider glue.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thezem/AgentKit.git"
  },
  "homepage": "https://github.com/thezem/AgentKit#readme",
  "bugs": {
    "url": "https://github.com/thezem/AgentKit/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "opencode",
    "agent-harness",
    "sdk",
    "typescript"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./capsules/claude-code": {
      "types": "./dist/capsules/claude-code/index.d.ts",
      "import": "./dist/capsules/claude-code/index.js"
    },
    "./capsules/codex": {
      "types": "./dist/capsules/codex/index.d.ts",
      "import": "./dist/capsules/codex/index.js"
    },
    "./capsules/opencode": {
      "types": "./dist/capsules/opencode/index.d.ts",
      "import": "./dist/capsules/opencode/index.js"
    },
    "./capsules/mock": {
      "types": "./dist/capsules/mock/index.d.ts",
      "import": "./dist/capsules/mock/index.js"
    },
    "./contract": {
      "types": "./dist/capsules/shared/contract.d.ts",
      "import": "./dist/capsules/shared/contract.js"
    }
  },
  "files": [
    "dist",
    "capsules/**/docs",
    "capsules/**/capsule.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && node test/e2e/conformance.ts mock && node test/e2e/durable.ts mock",
    "e2e": "node test/e2e/conformance.ts",
    "e2e:mock": "node test/e2e/conformance.ts mock",
    "doctor": "node examples/doctor.ts",
    "example": "node examples/quickstart.ts",
    "harness": "node examples/harness-server.ts",
    "prepack": "npm run build",
    "ui:api": "node examples/web/server.ts",
    "ui": "npm --prefix examples/web run dev",
    "e2e:durable": "node test/e2e/durable.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@anthropic-ai/sdk": "^0.135.0",
    "@opencode/client": "^2.0.26"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^7.0.2"
  }
}
