{
  "name": "@ouim/agentkit",
  "version": "0.1.0",
  "type": "module",
  "description": "One TypeScript API for building on top of local Codex and Claude agent runtimes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thezem/agentkit.git"
  },
  "homepage": "https://github.com/thezem/agentkit#readme",
  "bugs": {
    "url": "https://github.com/thezem/agentkit/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "codex",
    "claude",
    "sdk",
    "typescript",
    "cli",
    "runtime"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat/codex": {
      "types": "./dist/compat/codex.d.ts",
      "import": "./dist/compat/codex.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "example": "node --experimental-strip-types examples/basic.ts",
    "smoke": "node --experimental-strip-types examples/basic.ts",
    "example:agent:codex": "node --experimental-strip-types examples/agent-codex.ts",
    "example:agent:claude": "node --experimental-strip-types examples/agent-claude.ts",
    "example:agent:t3code": "node --experimental-strip-types examples/agent-t3code.ts",
    "example:agent:t3code:ask": "node --experimental-strip-types examples/agent-t3code-ask.ts",
    "example:lifecycle": "node --experimental-strip-types examples/agent-lifecycle.ts",
    "example:handlers": "node --experimental-strip-types examples/handlers.ts",
    "example:safe-session": "node --experimental-strip-types examples/safe-session.ts",
    "example:models": "node --experimental-strip-types examples/models.ts",
    "example:skills": "node --experimental-strip-types examples/skills.ts",
    "example:inventory": "node --experimental-strip-types examples/provider-inventory.ts",
    "example:ci": "node --experimental-strip-types examples/ci.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.9.3"
  }
}
