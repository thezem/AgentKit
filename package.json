{
  "name": "@ouim/agentkit",
  "version": "0.1.0",
  "type": "module",
  "description": "High-level Node SDK for building on top of local agent runtimes.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "example": "node --experimental-strip-types examples/basic.ts",
    "smoke": "node --experimental-strip-types examples/basic.ts",
    "example:agent:codex": "node --experimental-strip-types examples/agent-codex.ts",
    "example:agent:claude": "node --experimental-strip-types examples/agent-claude.ts",
    "example:lifecycle": "node --experimental-strip-types examples/agent-lifecycle.ts",
    "example:handlers": "node --experimental-strip-types examples/handlers.ts",
    "example:models": "node --experimental-strip-types examples/models.ts",
    "example:skills": "node --experimental-strip-types examples/skills.ts",
    "example:inventory": "node --experimental-strip-types examples/provider-inventory.ts",
    "example:ci": "node --experimental-strip-types examples/ci.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.9.3"
  }
}
